{
  // Cloudflare Worker: serves public/ and handles /api/enquiry (see src/worker.js)
  "name": "vouch-digital",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // With a 404 page set, unmatched paths never reach the Worker unless listed here.
    "run_worker_first": ["/api/*", "/services/*"]
  }
}
